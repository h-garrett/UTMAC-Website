<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="../css/styles.css" rel="stylesheet">
    <link href="css/adminstyles.css" rel="stylesheet">
    <script type="module" src="../js/admin.js" defer></script>
    <title>UTMAC Admin</title>
</head>
<body>
    <h1>Current Phase: 
        <strong id="vote-status-text" style="text-transform: uppercase;"></strong>
    </h1>
    <form id="nomination-form" action="/api/settings/nomination" method="POST">
        <h2>Nomination Link:
            <label for="nominationLink"></label>
            <input type="url" id="nominationLink" name="nominationLink" value="<%= settings.nominationLink || '' %>">
            <button>Submit</button>
        </h2>
    </form>

    <form id="voting-form" action="/api/settings/voting" method="POST">
        <h2>Voting Link:
            <label for="votingLink"></label>
            <input type="url" id="votingLink" name="votingLink" value="<%= settings.votingLink || '' %>">
            <button>Submit</button>
        </h2>
    </form>

    <form id="phase-form" action="/api/settings/phase" method="POST">
        <h2>Phase Override: 
            <label for="phaseOverride"></label>
            <input type="checkbox" id="phaseOverride" name="phaseOverride" <%= settings.phaseOverride ? 'checked' : ''%>>
            <label for="setPhase"></label>
            <select name="setPhase" id="setPhase">
                <option value="nominations" <%= settings.setPhase === 'nominations' ? 'selected' : '' %>>Nominate</option>
                <option value="voting" <%= settings.setPhase === 'voting' ? 'selected' : '' %>>Vote</option>
                <option value="closed" <%= settings.setPhase === 'closed' ? 'selected' : '' %>>Closed</option>
                <option value="listen" <%= settings.setPhase === 'listen' ? 'selected' : '' %>>Listen</option>
                <option value="custom" <%= settings.setPhase === 'custom' ? 'selected' : '' %>>Custom</option>
            </select>
            <button>Submit</button>
        </h2>
    </form>

    <form id="genre-form" action="/api/settings/genre" method="POST">
        <h2>Genre of the Week:
            <label for="setGenre"></label>
            <input type="text" id="setGenre" name="setGenre" required value="<%= settings.setGenre || '' %>">
            <button>Submit</button>
        </h2>
    </form>

    <form id="custom-phase-form" action="/api/settings/custom-phase" method="POST">
        <h2>Custom phase:
            <br>
            <label for="showButton">Button?</label>
            <input type="checkbox" id="showButton" name="showButton" <%= settings.showButton ? 'checked' : ''%>>
            <br>
            <label for="buttonLink">Button Link:</label>
            <input type="url" id="buttonLink" name="buttonLink" value="<%= settings.buttonLink || '' %>">
            <br>
            <label for="buttonText">Button Text:</label>
            <input type="text" name="buttonText" id="buttonText" value="<%= settings.buttonText || '' %>">
            <br>
            <label for="customText">Text Box:</label>
            <input type="text" name="customText" id="customText" value="<%= settings.customText || '' %>">
            <br>

            <button>Submit</button>
        </h2>

    </form>
    <a href="/" id="home">Home</a>

    <p id="save-status"></p>
</body>
</html>